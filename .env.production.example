# Copy to .env.production and fill in. .env.production is gitignored.
# Vite reads these at `npm run build` time and bakes them into the bundle.

# Production deploy: live mode, no fixtures.
VITE_DIRECTOR_MOCK=0

# Production Worker URL. Replace with your deployed Worker.
VITE_DIRECTOR_WORKER_URL=https://yatra-director.<your-subdomain>.workers.dev

# Cloudflare Turnstile site key for the production frontend.
# Site keys are public by Cloudflare design — safe to bake into the bundle.
# Get one at https://dash.cloudflare.com/?to=/:account/turnstile (create site,
# domain = your Pages URL, mode = invisible).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
