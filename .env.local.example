# Copy to .env.local and fill in. .env.local is gitignored.
# These control the Director surface's connection to the
# workers/yatra-director Cloudflare Worker.

# Mock mode: 1 = bypass the Worker entirely; use the canned Yadagiri
# fixture + silent audio. Fast iteration loop, no keys needed.
# Set to 0 once you have the Worker provisioned (see workers/yatra-director/README.md).
VITE_DIRECTOR_MOCK=1

# Worker URL. For local dev, point at the Wrangler dev server.
# For prod, set this to your deployed Worker URL (e.g. https://yatra-director.yourname.workers.dev).
VITE_DIRECTOR_WORKER_URL=http://localhost:8787
